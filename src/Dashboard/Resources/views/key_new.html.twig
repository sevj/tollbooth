{% extends '@TollboothDashboard/layout.html.twig' %}
{% trans_default_domain 'tollbooth' %}

{% set group = shell.group %}

{% block title %}{{ 'dashboard.keys.new'|trans }}{% endblock %}

{% block crumbs %}<a href="{{ path('tollbooth_dashboard_map', {group: group}) }}">{{ group }}</a> <span class="slash">/</span> <a href="{{ path('tollbooth_dashboard_consumers', {group: group}) }}">{{ 'dashboard.consumers.crumb'|trans }}</a> <span class="slash">/</span> <span class="here">{{ 'dashboard.keys.new_crumb'|trans }}</span>{% endblock %}

{% macro error(form, field) %}{% if form.errors[field] is defined %}<span class="field-error" id="{{ field }}-error">{{ ('dashboard.keys.error.' ~ form.errors[field])|trans({}, 'tollbooth') }}</span>{% endif %}{% endmacro %}

{% block body %}
<div class="head">
<div>
<h1>{{ 'dashboard.keys.new'|trans }}</h1>
<div class="sub">{{ 'dashboard.keys.new_sub'|trans }}</div>
</div>
</div>

<section class="panel form-panel">
<form method="post" action="{{ path('tollbooth_dashboard_key_new', {group: group}) }}" class="form" novalidate>
<input type="hidden" name="_token" value="{{ tb_token('create') }}">
<label class="field"><span>{{ 'dashboard.keys.name'|trans }}</span><input type="text" name="name" value="{{ form.name }}" required maxlength="64" placeholder="acme-erp"{% if form.errors.name is defined %} aria-invalid="true" aria-describedby="name-error"{% endif %}><small>{{ 'dashboard.keys.name_help'|trans }}</small>{{ _self.error(form, 'name') }}</label>
<label class="field"><span>{{ 'dashboard.keys.plan'|trans }}</span><select name="plan"{% if form.errors.plan is defined %} aria-invalid="true" aria-describedby="plan-error"{% endif %}><option value="">{{ 'dashboard.keys.no_plan'|trans }}</option>{% for plan in plans %}<option value="{{ plan }}"{% if form.plan == plan %} selected{% endif %}>{{ plan }}</option>{% endfor %}</select>{{ _self.error(form, 'plan') }}</label>
<label class="field"><span>{{ 'dashboard.keys.scopes'|trans }}</span><input type="text" name="scopes" value="{{ form.rawScopes }}" placeholder="orders:read orders:write"{% if form.errors.scopes is defined %} aria-invalid="true" aria-describedby="scopes-error"{% endif %}><small>{{ 'dashboard.keys.scopes_help'|trans }}</small>{{ _self.error(form, 'scopes') }}</label>
<label class="field"><span>{{ 'dashboard.keys.expires'|trans }}</span><input type="date" name="expires" value="{{ form.rawExpires }}"{% if form.errors.expires is defined %} aria-invalid="true" aria-describedby="expires-error"{% endif %}><small>{{ 'dashboard.keys.expires_help'|trans }}</small>{{ _self.error(form, 'expires') }}</label>
<label class="field"><span>{{ 'dashboard.keys.ips'|trans }}</span><input type="text" name="allowed_ips" value="{{ form.rawIps }}" placeholder="203.0.113.0/24"{% if form.errors.allowed_ips is defined %} aria-invalid="true" aria-describedby="allowed_ips-error"{% endif %}><small>{{ 'dashboard.keys.ips_help'|trans }}</small>{{ _self.error(form, 'allowed_ips') }}</label>
<label class="check"><input type="checkbox" name="test" value="1"{% if form.test %} checked{% endif %}><span>{{ 'dashboard.keys.test'|trans }}</span></label>
<div class="form-actions"><a class="btn" href="{{ path('tollbooth_dashboard_consumers', {group: group}) }}">{{ 'dashboard.keys.cancel'|trans }}</a><button class="btn pri" type="submit">{{ 'dashboard.keys.create'|trans }}</button></div>
</form>
</section>
{% endblock %}
