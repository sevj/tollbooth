{% extends '@TollboothDashboard/layout.html.twig' %}
{% trans_default_domain 'tollbooth' %}

{% set group = shell.group %}
{% set state = report.status.value %}

{% block title %}{{ 'dashboard.health.title'|trans }}{% endblock %}

{% block crumbs %}<a href="{{ path('tollbooth_dashboard_map', {group: group}) }}">{{ group }}</a> <span class="slash">/</span> <span class="here">{{ 'dashboard.health.crumb'|trans }}</span>{% endblock %}

{% block body %}
<section class="panel hero">
<div class="hero-main">
<div class="hero-mark {{ state }}" aria-hidden="true"></div>
<div>
<h1>{{ ('dashboard.health.status.' ~ state)|trans }}</h1>
<div class="sub m mu">{{ 'dashboard.health.summary'|trans({'%warnings%': warnings, '%criticals%': criticals, '%checks%': report.checks|length}) }} · {{ 'dashboard.health.checked'|trans({'%time%': report.checkedAt|date('H:i:s', 'UTC')}) }}</div>
</div>
</div>
<div class="actions">
<button class="btn" type="button" data-copy="{{ probe }}"><span data-copy-label data-done="{{ 'dashboard.endpoint.copied'|trans }}">{{ 'dashboard.health.copy_probe'|trans }}</span></button>
<a class="btn pri" href="{{ path('tollbooth_dashboard_health', {group: group}) }}">{{ 'dashboard.health.run'|trans }}</a>
</div>
</section>

<div class="cols">
<div class="col" style="flex: 1.5 1 560px">
<section class="panel" aria-labelledby="checks-title">
<div class="ph"><h2 id="checks-title">{{ 'dashboard.health.checks'|trans }}</h2><span class="m mu" style="font-size: 12px">{{ 'dashboard.health.checks_sub'|trans }}</span></div>
<div style="overflow-x: auto"><div style="min-width: 600px">
{% for source, checks in sources %}
<div class="gh"><span>{{ ('dashboard.health.source.' ~ source)|trans }}</span><span class="mu" style="font-weight: 400">{{ checks|length }}</span></div>
{% for check in checks %}
<div class="ck {{ check.status.value }}"><span class="dot {{ check.status.value }}"></span><span class="n">{{ check.name }}</span><span{% if check.status.value == 'ok' %} class="mu"{% endif %}>{{ check.summary }}</span><span class="t">{{ check.duration }} ms</span></div>
{% endfor %}
{% endfor %}
</div></div>
</section>

<section class="panel" aria-labelledby="findings-title">
<div class="ph"><h2 id="findings-title">{{ 'dashboard.health.findings'|trans }}</h2><span class="m mu" style="font-size: 12px">{{ 'dashboard.health.findings_sub'|trans }}</span></div>
{% for finding in report.findings %}
<div class="fd"><span class="dot {{ finding.warning ? 'warning' : 'info' }}"></span><span>{{ finding.message }}</span></div>
{% else %}
<div class="fd"><span class="dot ok"></span><span class="mu">{{ 'dashboard.health.no_findings'|trans }}</span></div>
{% endfor %}
</section>
</div>

<div class="col" style="flex: 1 1 380px">
<section class="panel" aria-labelledby="facts-title">
<div class="ph"><h2 id="facts-title">{{ 'dashboard.health.facts'|trans }}</h2></div>
<div class="kv" style="padding: 16px 20px">
{% for name, value in report.facts %}<span>{{ name|replace({'_': ' '}) }}</span><span>{{ value }}</span>{% endfor %}
<span>api</span><span>{{ 'dashboard.map.count.endpoints'|trans({'%count%': shell.endpoints}) }}{% if shell.models is not null %} · {{ 'dashboard.map.count.models'|trans({'%count%': shell.models}) }}{% endif %}</span>
</div>
</section>

<section class="panel" aria-labelledby="probes-title">
<div class="ph"><h2 id="probes-title">{{ 'dashboard.health.probes'|trans }}</h2><span class="m mu" style="font-size: 12px">{{ 'dashboard.health.probes_sub'|trans }}</span></div>
<div class="probes">
<div><span><span class="GET">GET</span> {{ live }}</span><span class="mu">{{ 'dashboard.health.live'|trans }}</span></div>
<div><span><span class="GET">GET</span> {{ ready }}</span><span class="mu">{{ 'dashboard.health.ready'|trans }}</span></div>
</div>
<pre class="code">{{ tb_json(public) }}</pre>
<div class="m mu" style="font-size: 11px; padding: 0 20px 16px">{{ 'dashboard.health.token'|trans }}</div>
</section>
</div>
</div>
{% endblock %}
