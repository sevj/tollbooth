{% trans_default_domain 'tollbooth' %}
<!doctype html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{% block title %}{% endblock %} · Tollbooth</title>
<link rel="icon" href="{{ tb_asset('favicon.svg') }}" type="image/svg+xml">
<script>try{var t=localStorage.getItem('tollbooth.theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
<link rel="stylesheet" href="{{ tb_asset('dashboard.css') }}">
<script type="module" src="{{ tb_asset('dashboard.js') }}"></script>
</head>
<body>
<div class="app">

<nav class="side" aria-label="{{ 'dashboard.nav.label'|trans }}">
<a class="brand" href="{{ path('tollbooth_dashboard') }}">
<svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="3" height="16" style="fill: var(--text)"></rect><rect x="5" y="6" width="18" height="5" style="fill: var(--accent)"></rect><path d="M8 6h3l-2.5 5h-3zM15 6h3l-2.5 5h-3z" style="fill: var(--side)"></path></svg>
<span>tollbooth</span>
</a>

<details class="groups">
<summary class="btn"><span class="m" style="font-size: 12px">{{ shell.group }} <span class="mu">{{ shell.mount }}</span></span><svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="stroke: var(--muted)" stroke-width="1.5" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5"></path></svg><span class="sr">{{ 'dashboard.nav.switch_group'|trans }}</span></summary>
<ul>
{% for group in shell.groups %}
<li><a href="{{ group.url }}"{% if group.name == shell.group %} aria-current="page"{% endif %}><span>{{ group.name }}</span><span class="mu">{{ group.mount }}</span></a></li>
{% endfor %}
</ul>
</details>

<a class="nav{% if shell.screen == 'map' %} on{% endif %}" href="{{ path('tollbooth_dashboard_map', {group: shell.group}) }}"{% if shell.screen == 'map' %} aria-current="page"{% endif %}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="1.5" y="1.5" width="5" height="5"></rect><rect x="9.5" y="1.5" width="5" height="5"></rect><rect x="1.5" y="9.5" width="5" height="5"></rect><path d="M6.5 4h3M4 6.5v3"></path></svg>{{ 'dashboard.nav.map'|trans }}</a>
<a class="nav{% if shell.screen in ['endpoint', 'endpoints'] %} on{% endif %}" href="{{ path('tollbooth_dashboard_endpoints', {group: shell.group}) }}"{% if shell.screen == 'endpoints' %} aria-current="page"{% endif %}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M1.5 3h2M6 3h8.5M1.5 8h2M6 8h8.5M1.5 13h2M6 13h8.5"></path></svg>{{ 'dashboard.nav.endpoints'|trans }}<span class="count">{{ shell.endpoints }}</span></a>
{% if shell.models is not null %}
<a class="nav{% if shell.screen == 'models' %} on{% endif %}" href="{{ path('tollbooth_dashboard_models', {group: shell.group}) }}"{% if shell.screen == 'models' %} aria-current="page"{% endif %}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="1.5" y="2" width="13" height="12"></rect><path d="M1.5 6h13M6 6v8"></path></svg>{{ 'dashboard.nav.models'|trans }}<span class="count">{{ shell.models }}</span></a>
{% endif %}
{% if shell.requests %}
<a class="nav{% if shell.screen == 'requests' %} on{% endif %}" href="{{ path('tollbooth_dashboard_requests', {group: shell.group}) }}"{% if shell.screen == 'requests' %} aria-current="page"{% endif %}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M1.5 5h11M10 2.5 12.5 5 10 7.5M14.5 11h-11M6 8.5 3.5 11 6 13.5"></path></svg>{{ 'dashboard.nav.requests'|trans }}</a>
<a class="nav{% if shell.screen == 'consumers' %} on{% endif %}" href="{{ path('tollbooth_dashboard_consumers', {group: shell.group}) }}"{% if shell.screen == 'consumers' %} aria-current="page"{% endif %}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 14v-1.5A3.5 3.5 0 0 1 5.5 9h1A3.5 3.5 0 0 1 10 12.5V14M6 7a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM11 2.2a2.5 2.5 0 0 1 0 4.6M12.5 9.2A3.5 3.5 0 0 1 14.5 12.5V14"></path></svg>{{ 'dashboard.nav.consumers'|trans }}</a>
{% endif %}
{% if shell.changes is not null %}
<a class="nav{% if shell.screen == 'changes' %} on{% endif %}" href="{{ path('tollbooth_dashboard_changes', {group: shell.group}) }}"{% if shell.screen == 'changes' %} aria-current="page"{% endif %}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="4" cy="3.5" r="1.8"></circle><circle cx="12" cy="12.5" r="1.8"></circle><path d="M4 5.3V14.5M12 10.7V6.5a2 2 0 0 0-2-2H7M8.5 3 7 4.5 8.5 6"></path></svg>{{ 'dashboard.nav.changes'|trans }}{% if shell.changes > 0 %}<span class="count" style="color: var(--bad)">{{ shell.changes }}</span>{% endif %}</a>
{% endif %}
<div class="sep"></div>
{% if shell.health %}
<a class="nav{% if shell.screen == 'health' %} on{% endif %}" href="{{ path('tollbooth_dashboard_health', {group: shell.group}) }}"{% if shell.screen == 'health' %} aria-current="page"{% endif %}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M1.5 8.5h3l1.5-4 3 7.5 1.5-3.5h4"></path></svg>{{ 'dashboard.nav.health'|trans }}</a>
{% endif %}
<a class="nav{% if shell.screen == 'configuration' %} on{% endif %}" href="{{ path('tollbooth_dashboard_configuration', {group: shell.group}) }}"{% if shell.screen == 'configuration' %} aria-current="page"{% endif %}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 4.5h7M12 4.5h2M2 11.5h2M7 11.5h7"></path><circle cx="10.5" cy="4.5" r="1.5"></circle><circle cx="5.5" cy="11.5" r="1.5"></circle></svg>{{ 'dashboard.nav.configuration'|trans }}</a>
{% if shell.docs %}
<a class="nav" href="{{ shell.docs }}"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 4 1.5 8 5 12M11 4l3.5 4-3.5 4M9.5 2.5l-3 11"></path></svg>{{ 'dashboard.nav.openapi'|trans }}</a>
{% endif %}

<div class="side-foot">
{% if shell.collector %}
<div class="state" title="{{ shell.collector.summary }}"><span class="dot {{ shell.collector.status }}"></span>{{ ('dashboard.nav.collector.' ~ shell.collector.status)|trans }}</div>
{% endif %}
<div class="theme" role="group" aria-label="{{ 'dashboard.theme.label'|trans }}"><button type="button" data-theme-choice="auto" aria-pressed="true">{{ 'dashboard.theme.auto'|trans }}</button><button type="button" data-theme-choice="light" aria-pressed="false">{{ 'dashboard.theme.light'|trans }}</button><button type="button" data-theme-choice="dark" aria-pressed="false">{{ 'dashboard.theme.dark'|trans }}</button></div>
<div>tollbooth {{ shell.version }} · symfony {{ shell.symfony }}</div>
</div>
</nav>

<main class="main">
<div class="top">
<div class="crumbs">{% block crumbs %}{% endblock %}</div>
<label class="search">
<svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="stroke: var(--faint)" stroke-width="1.4" aria-hidden="true"><circle cx="6" cy="6" r="4.5"></circle><path d="m9.5 9.5 3 3"></path></svg>
<span class="sr">{{ 'dashboard.search.label'|trans }}</span>
<input type="search" data-search placeholder="{{ 'dashboard.search.placeholder'|trans }}" autocomplete="off">
<kbd>⌘K</kbd>
</label>
{% block toolbar %}{% endblock %}
<span class="btn" title="{{ 'dashboard.environment'|trans }}"><span class="dot {{ shell.environment == 'prod' ? 'ok' : 'warning' }}"></span><span class="m" style="font-size: 12px">{{ shell.environment }}</span></span>
</div>
{% block body %}{% endblock %}
</main>

</div>
</body>
</html>
