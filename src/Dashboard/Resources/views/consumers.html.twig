{% extends '@TollboothDashboard/layout.html.twig' %}
{% trans_default_domain 'tollbooth' %}

{% set group = shell.group %}

{% block title %}{{ 'dashboard.consumers.title'|trans }} · {{ group }}{% endblock %}

{% block crumbs %}<a href="{{ path('tollbooth_dashboard_map', {group: group}) }}">{{ group }}</a> <span class="slash">/</span> <span class="here">{{ 'dashboard.consumers.crumb'|trans }}</span>{% endblock %}

{% block body %}
<div class="head">
<div>
<h1>{{ 'dashboard.consumers.title'|trans }}</h1>
<div class="sub">{{ 'dashboard.consumers.summary'|trans({'%active%': active, '%count%': keys ?? total}) }} · {{ 'dashboard.consumers.plans'|trans({'%count%': plans|length}) }}</div>
</div>
<div class="actions">
{% if plans is not empty %}<a class="btn" href="{{ path('tollbooth_dashboard_configuration', {group: group}) }}#plans-title">{{ 'dashboard.consumers.manage_plans'|trans }}</a>{% endif %}
{% if can_create %}
<a class="btn pri" href="{{ path('tollbooth_dashboard_key_new', {group: group}) }}"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 1.5v9M1.5 6h9"></path></svg>{{ 'dashboard.keys.new'|trans }}</a>
{% endif %}
</div>
</div>
{% if revoked %}<div class="notice" role="status"><span class="dot ok"></span>{{ 'dashboard.keys.revoked'|trans({'%name%': revoked}) }}</div>{% endif %}

{% if plans is not empty %}
<div class="plans">
{% for plan in plans %}
{% set day = plan.limits|filter(l => l.window == 86400)|first %}
{% set minute = plan.limits|filter(l => l.window == 60)|first %}
{% set main = [day, minute]|filter(l => l) %}
{% set rest = plan.limits|filter(l => l.window != 86400 and l.window != 60) %}
<div class="plan">
<div class="plan-head"><strong>{{ plan.name|capitalize }}{% if plan.default %} <span class="mu">· {{ 'dashboard.consumers.default_plan'|trans }}</span>{% endif %}</strong><span class="m mu">{{ 'dashboard.consumers.keys'|trans({'%count%': plan.keys}) }}</span></div>
<div class="plan-limits m">{% if main is empty %}{% for limit in plan.limits|slice(0, 2) %}{% if not loop.first %} <span class="dotsep">·</span> {% endif %}{% include '@TollboothDashboard/_limit.html.twig' %}{% endfor %}{% else %}{% if not day %}{{ 'dashboard.consumers.no_cap'|trans }} <span class="dotsep">·</span> {% endif %}{% for limit in main %}{% if not loop.first %} <span class="dotsep">·</span> {% endif %}{% include '@TollboothDashboard/_limit.html.twig' %}{% endfor %}{% endif %}</div>
<div class="m mu plan-foot">{{ 'dashboard.consumers.fixed_window'|trans }}{% for limit in rest %} · {{ limit.name|split('.')|last }} {% include '@TollboothDashboard/_limit.html.twig' %}{% endfor %}</div>
</div>
{% endfor %}
</div>
{% endif %}

<section class="panel" aria-labelledby="flow-title">
<div class="ph"><h2 id="flow-title">{{ 'dashboard.consumers.flow'|trans }}</h2><span class="m mu" style="font-size: 12px">{{ 'dashboard.consumers.flow_sub'|trans({'%count%': flow.total|tb_compact}) }}</span></div>
{% if flow.total == 0 %}
<div class="empty">{{ 'dashboard.consumers.no_traffic'|trans }}</div>
{% else %}
<div style="overflow-x: auto; padding: 24px 20px">
<svg width="920" height="340" viewBox="0 -10 920 340" class="flow" role="img" aria-label="{% for node in flow.sources %}{{ node.label }} {{ node.share|tb_percent(0) }}{% if not loop.last %}, {% endif %}{% endfor %}">
<g transform="translate(140,0)">
<g fill-opacity="0.34">{% for f in flow.flows %}<path style="fill: {{ f.color }}" d="{{ f.path }}"><title>{{ f.title }}</title></path>{% endfor %}</g>
{% for node in flow.sources %}<rect x="0" y="{{ node.y }}" width="12" height="{{ max(node.height, 1) }}" style="fill: {{ node.color }}"></rect>{% endfor %}
{% for node in flow.targets %}<rect x="628" y="{{ node.y }}" width="12" height="{{ max(node.height, 1) }}" style="fill: var(--neutral)"></rect>{% endfor %}
<g text-anchor="end">{% for node in flow.sources %}{% if node.id %}<a href="{{ path('tollbooth_dashboard_consumer', {group: group, consumer: node.id}) }}">{% endif %}<text x="-12" y="{{ node.labelY }}">{{ node.label|tb_truncate(14) }} <tspan class="pct">{{ node.share|tb_percent(0) }}</tspan></text>{% if node.id %}</a>{% endif %}{% endfor %}</g>
<g>{% for node in flow.targets %}<text x="652" y="{{ node.labelY }}">{{ node.label|tb_truncate(18) }} <tspan class="pct">{{ node.share|tb_percent(0) }}</tspan></text>{% endfor %}</g>
</g>
</svg>
</div>
{% endif %}
</section>

<section class="panel" aria-labelledby="keys-title">
<div class="ph" style="padding: 12px 20px">
<h2 id="keys-title" style="margin-right: auto">{{ 'dashboard.consumers.table'|trans }}</h2>
<div class="segs inset" role="group" aria-label="{{ 'dashboard.consumers.filter'|trans }}">
{% for option in filters %}<a class="seg{% if show == option %} sel{% endif %}" href="{{ path('tollbooth_dashboard_consumers', {group: group, show: option}) }}"{% if show == option %} aria-current="true"{% endif %}>{{ ('dashboard.consumers.show.' ~ option)|trans }}</a>{% endfor %}
</div>
</div>
<div style="overflow-x: auto"><div style="min-width: 1100px">
<div class="kt th"><span>{{ 'dashboard.consumers.col.consumer'|trans }}</span><span>{{ 'dashboard.consumers.col.key'|trans }}</span><span>{{ 'dashboard.consumers.col.plan'|trans }}</span><span class="r">{{ 'dashboard.consumers.col.calls'|trans }}</span><span>{{ 'dashboard.consumers.col.quota'|trans }}</span><span class="r">{{ 'dashboard.consumers.col.peak'|trans }}</span><span class="r">429</span><span class="r">{{ 'dashboard.consumers.col.errors'|trans }}</span><span class="r">{{ 'dashboard.consumers.col.seen'|trans }}</span></div>
{% for row in rows %}
{% set quota = row.quota %}
<div class="kt{% if row.nearLimit %} near{% endif %}" data-search-text="{{ row.name|lower }}">
<span class="nm">{% if row.anonymous %}<span>{{ 'dashboard.consumers.anonymous'|trans({'%count%': row.members}) }}</span>{% else %}<a href="{{ path('tollbooth_dashboard_consumer', {group: group, consumer: row.id}) }}">{{ row.name }}</a>{% endif %}{% if row.key is null and not row.anonymous %}<span class="pl other">{{ ('dashboard.auth.' ~ row.method)|trans }}</span>{% endif %}</span>
<span class="mu">{{ row.key ? row.key.id : '—' }}</span>
<span>{% if row.plan %}<span class="pl {{ row.plan }}">{{ row.plan|upper }}</span>{% else %}<span class="mu">—</span>{% endif %}</span>
<span class="r">{{ row.calls|tb_number }}</span>
<span class="quota">{% if quota is not null %}<span class="bar{% if quota >= 0.9 %} full{% endif %}"><span style="width: {{ (quota * 100)|round(1) }}%"></span></span><span class="pc{% if quota >= 0.9 %} warn{% endif %}">{{ quota|tb_percent(0) }}</span>{% else %}<span class="mu">{{ row.plan ? 'dashboard.consumers.no_cap'|trans : '—' }}</span>{% endif %}</span>
<span class="r{% if row.peak and row.minuteLimit and row.peak > row.minuteLimit %} bad{% endif %}">{{ row.peak is null ? '—' : row.peak|tb_number }}{% if row.minuteLimit %}<span class="mu"> /{{ row.minuteLimit|tb_compact }}</span>{% endif %}</span>
<span class="r{% if not row.throttled %} mu{% endif %}">{{ (row.stats.throttled ?? 0)|tb_number }}</span>
<span class="r{% if row.stats and row.stats.errorRate > 0.01 %} bad{% endif %}">{{ row.stats ? row.stats.errorRate|tb_percent(2) : '—' }}</span>
<span class="r mu">{% if row.anonymous %}—{% elseif row.last %}{% set ago = tb_ago(row.last.occurredAt) %}{{ ('dashboard.ago.' ~ ago.unit)|trans({'%count%': ago.count}) }}{% else %}{{ 'dashboard.consumers.never'|trans }}{% endif %}</span>
</div>
{% else %}
<div class="empty">{{ 'dashboard.consumers.none'|trans }}</div>
{% endfor %}
</div></div>
<div class="list-foot"><span>{{ 'dashboard.consumers.shown'|trans({'%shown%': rows|length, '%count%': total}) }}</span></div>
</section>
{% endblock %}
