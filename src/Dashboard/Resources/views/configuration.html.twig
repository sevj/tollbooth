{% extends '@TollboothDashboard/layout.html.twig' %}
{% trans_default_domain 'tollbooth' %}

{% set group = shell.group %}

{% block title %}{{ 'dashboard.configuration.title'|trans }} · {{ group }}{% endblock %}

{% block crumbs %}<a href="{{ path('tollbooth_dashboard_map', {group: group}) }}">{{ group }}</a> <span class="slash">/</span> <span class="here">{{ 'dashboard.configuration.crumb'|trans }}</span>{% endblock %}

{% block body %}
<div class="head">
<div>
<h1>{{ 'dashboard.configuration.title'|trans }}</h1>
<div class="sub">{{ 'dashboard.configuration.subtitle'|trans }}</div>
</div>
</div>
{% if saved %}<div class="notice" role="status"><span class="dot ok"></span>{{ 'dashboard.plans.saved'|trans({'%name%': saved}) }}</div>{% endif %}
{% if deleted %}<div class="notice" role="status"><span class="dot ok"></span>{{ 'dashboard.plans.deleted'|trans({'%name%': deleted}) }}</div>{% endif %}

<section class="panel" aria-labelledby="plans-title">
<div class="ph">
<h2 id="plans-title">{{ 'dashboard.plans.title'|trans }}<span class="m">{{ plans|length }}</span></h2>
{% if editable %}<a class="btn pri sm" href="{{ path('tollbooth_dashboard_plan_new', {group: group}) }}"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 1.5v9M1.5 6h9"></path></svg>{{ 'dashboard.plans.new'|trans }}</a>{% endif %}
</div>
{% if not rate_limited %}
<div class="empty">{{ 'dashboard.plans.disabled'|trans }}</div>
{% else %}
<p class="panel-note">{{ 'dashboard.plans.explain'|trans }}{% if not editable %} {{ 'dashboard.plans.read_only'|trans }}{% endif %}</p>
{% if plans is empty %}
<div class="empty">{{ 'dashboard.plans.none'|trans }}</div>
{% else %}
<div class="pt th"><span>{{ 'dashboard.plans.col.plan'|trans }}</span><span>{{ 'dashboard.plans.col.limits'|trans }}</span><span class="r">{{ 'dashboard.plans.col.keys'|trans }}</span><span>{{ 'dashboard.plans.col.source'|trans }}</span><span></span></div>
{% for plan in plans %}
<div class="pt">
<span><strong class="m">{{ plan.name }}</strong>{% if plan.default %} <span class="tagk">{{ 'dashboard.plans.default'|trans }}</span>{% endif %}{% if plan.anonymous %} <span class="tagk">{{ 'dashboard.plans.anonymous'|trans }}</span>{% endif %}</span>
<span class="m">{% for limit in plan.limits %}{% if not loop.first %} <span class="dotsep">·</span> {% endif %}{% include '@TollboothDashboard/_limit.html.twig' %}{% endfor %}</span>
<span class="r m">{{ keys_listed ? plan.keys : '—' }}</span>
<span class="mu">{{ plan.configured ? 'dashboard.plans.source.config'|trans : 'dashboard.plans.source.dashboard'|trans }}</span>
<span class="pt-actions">{% if not plan.configured and editable %}<a class="btn sm" href="{{ path('tollbooth_dashboard_plan_edit', {group: group, plan: plan.name}) }}">{{ 'dashboard.plans.edit'|trans }}</a>{% if plan.keys == 0 %}<form method="post" action="{{ path('tollbooth_dashboard_plan_delete', {group: group, plan: plan.name}) }}" data-confirm="{{ 'dashboard.plans.confirm_delete'|trans({'%name%': plan.name}) }}"><input type="hidden" name="_token" value="{{ tb_token('plan_delete', plan.name) }}"><button class="btn sm dng" type="submit">{{ 'dashboard.plans.delete'|trans }}</button></form>{% endif %}{% endif %}</span>
</div>
{% endfor %}
{% endif %}
{% endif %}
</section>

<div class="settings">
{% for section in sections %}
<section class="panel" aria-labelledby="section-{{ section.section|replace({'.': '-'}) }}">
<div class="ph"><h2 id="section-{{ section.section|replace({'.': '-'}) }}">{{ ('dashboard.configuration.section.' ~ section.section)|trans }}</h2></div>
<div class="kv settings-kv">{% for row in section.rows %}<span>{{ row.key }}</span><span>{{ row.value }}</span>{% endfor %}</div>
</section>
{% endfor %}
</div>
{% endblock %}
