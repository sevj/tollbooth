{
    "name": "tollbooth/tollbooth-bundle",
    "description": "Declare Symfony API endpoints with attributes and get routing, validation, documentation, rate limiting and monitoring.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "api", "rest", "openapi", "rate-limit", "monitoring"],
    "require": {
        "php": ">=8.4",
        "phpdocumentor/type-resolver": "^1.9 || ^2.0",
        "phpstan/phpdoc-parser": "^2.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/lock": "^7.4 || ^8.0",
        "symfony/property-access": "^7.4 || ^8.0",
        "symfony/property-info": "^7.4 || ^8.0",
        "symfony/serializer": "^7.4 || ^8.0",
        "symfony/string": "^7.4 || ^8.0",
        "symfony/type-info": "^7.4 || ^8.0",
        "symfony/validator": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "suggest": {
        "symfony/security-bundle": "To accept the jwt and user authentication methods",
        "doctrine/doctrine-bundle": "To store monitored calls in a database configured by the application",
        "symfony/translation": "With symfony/twig-bundle, to serve the operator dashboard",
        "symfony/twig-bundle": "To serve the operator dashboard"
    },
    "autoload": {
        "psr-4": {
            "Tollbooth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tollbooth\\Tests\\": "tests/",
            "Tollbooth\\Demo\\": "demo/src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "deptrac": "deptrac analyse --no-progress",
        "qa": [
            "@cs",
            "@stan",
            "@deptrac",
            "@test"
        ]
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.4",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0"
    }
}
